    <style name="Theme.WarmWord.Splash" parent="Theme.WarmWord">
        <item name="windowSplashScreenBackground">@color/warm_cream</item>
        <item name="postSplashScreenTheme">@style/Theme.WarmWord</item>
    </style>
</resources>
